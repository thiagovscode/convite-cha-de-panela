{
  "name": "convite-cha-de-panela",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",

    "server": "tsx watch server/index.ts",
    "seed": "tsx server/seed.ts",
    "java": "cd ../convite-cha-de-panela-backend && .\\mvnw spring-boot:run",
    "start": "concurrently --names \"FRONTEND,BACKEND\" --prefix-colors \"bgMagenta,bgBlue\" \"npm run dev\" \"npm run java\""
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.31.0",
    "mongodb": "^7.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "nodemon": "^3.1.14",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
