{
  // ── Configuração TypeScript para o servidor Express/Node ──
  // Usado pelo tsx para transpilar os arquivos em server/
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "outDir": "./dist-server",
    "rootDir": ".",
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["server/**/*", "src/config/convite.ts", "src/types/**/*"],
  "exclude": ["node_modules", "dist"]
}
