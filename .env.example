# ============================================================
#  VARIÁVEIS DE AMBIENTE
#  ============================================================
#  Copie este arquivo para .env e preencha com os seus dados.
#  O arquivo .env NUNCA deve ser enviado ao git.
# ============================================================

# ── MongoDB Atlas ──────────────────────────────────────────
# Obtenha sua connection string em:
# MongoDB Atlas → Connect → Drivers → Node.js
# Formato: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=mongodb+srv://SEU_USUARIO:SUA_SENHA@SEU_CLUSTER.mongodb.net/cha-panela?retryWrites=true&w=majority

# ── Servidor ───────────────────────────────────────────────
PORT=3001

# ── Frontend (para CORS) ───────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Segurança ──────────────────────────────────────────────
# Senha para acessar o painel administrativo (?admin=true)
ADMIN_PASSWORD=princesa2026
